<!-- .csproj: define como o projeto é compilado. "Sdk.Web" habilita o ASP.NET Core. -->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Versão do .NET usada -->
    <TargetFramework>net9.0</TargetFramework>
    <!-- O compilador avisa quando algo pode ser null (evita NullReferenceException) -->
    <Nullable>enable</Nullable>
    <!-- Dispensa os "using" mais comuns (System, System.Linq, etc.) em cada arquivo -->
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>7ad1a9f8-42fe-4231-852c-6f78babb103f</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pacotes NuGet (bibliotecas externas). Este gera o documento OpenAPI. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.22">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- EF Core: ORM que converte classes C# em tabelas/consultas. Provider SQLite = banco em um único arquivo. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.22" />
  </ItemGroup>

</Project>
